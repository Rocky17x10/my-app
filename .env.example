# Copy to .env and adjust (git-ignored). NEXT_PUBLIC_* values are visible in the browser: no secrets there.

# Backend base URL including the API version prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Browser tests (npm run test:e2e) only. Use existing accounts that have already changed their
# first password; never commit the real values.
# E2E_BASE_URL=http://localhost:3000
# E2E_BROWSER_CHANNEL=msedge
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_EMPLOYEE_EMAIL=
# E2E_EMPLOYEE_PASSWORD=
